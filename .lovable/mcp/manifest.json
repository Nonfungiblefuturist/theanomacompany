      {
        "name": "list_faqs",
        "title": "List FAQs",
        "description": "List The Anoma Company frequently asked questions and their answers.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_studio_info",
        "title": "Get studio info",
        "description": "Get The Anoma Company studio overview: positioning, contact details, social links, team and headline stats.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "submit_inquiry",
        "title": "Submit inquiry",
        "description": "Send a new project inquiry to The Anoma Company. Creates a contact submission the studio team will follow up on.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Contact name."
            },
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 255,
              "description": "Contact email address."
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "What the project is about."
            },
            "company": {
              "type": "string",
              "maxLength": 150
            },
            "phone": {
              "type": "string",
              "maxLength": 40
            },
            "service_interest": {
              "type": "string",
              "maxLength": 120,
              "description": "Service of interest, e.g. 'AI Video Production'."
            }
